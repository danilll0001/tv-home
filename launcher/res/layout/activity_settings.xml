<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ TV Launcher Einstellungen"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp" />

        <Switch
            android:id="@+id/swSound"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Apple-TV Klick-Sounds"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true" />

        <Switch
            android:id="@+id/swWeather"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Wetter-Widget anzeigen"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true" />

        <Switch
            android:id="@+id/swDayTimeBg"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Hintergrund an Tageszeit anpassen"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true" />

        <Switch
            android:id="@+id/swRecentApps"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Leiste 'Zuletzt verwendet' anzeigen"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true" />

        <Switch
            android:id="@+id/swHighContrast"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="High-Contrast-Modus (Kräftige Ränder)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true" />

        <Switch
            android:id="@+id/swMusicPlayer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Musik Mini-Player aktivieren"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSystemSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#33FFFFFF"
            android:text="🔧 Erweitere Android-Systemeinstellungen öffnen"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:background="#55FFFFFF"
            android:text="← Zurück"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
