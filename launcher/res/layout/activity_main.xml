<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:paddingStart="56dp"
    android:paddingEnd="56dp"
    android:paddingTop="40dp"
    android:paddingBottom="40dp">

    <!-- Header Links: Begrüßung, Uhrzeit & Datum -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guten Abend"
            android:textColor="#A0A0A0"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21:39"
            android:textColor="#FFFFFF"
            android:textSize="68sp"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Freitag, 23. Oktober"
            android:textColor="#707070"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Header Rechts: Status, Wetter & Top-Kacheln -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 Online"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33222222"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="☀️ 10°C • Heiter"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnDevices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="🎮 HDMI / Geräte"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="📱 Alle Apps"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FFFFFF"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="⚙ Einstellungen"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:focusable="true" />
    </LinearLayout>

    <!-- Musik Mini-Player (Wird bei Nicht-Nutzung ausgeblendet) -->
    <LinearLayout
        android:id="@+id/musicPlayerLayout"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:layout_marginTop="20dp"
        android:background="#44111111"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#66FFFFFF"
            android:gravity="center"
            android:text="🎵"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvMusicTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keine Wiedergabe"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMusicArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spotify / Medien"
                android:textColor="#A0A0A0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bereich Unten: Apps & Recent Apps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <!-- Zuletzt Verwendet (Recent Apps) Leiste -->
        <LinearLayout
            android:id="@+id/recentAppsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zuletzt verwendet:"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"
                android:layout_gravity="center_vertical" />

            <Button
                android:id="@+id/btnRecent1"
                android:layout_width="110dp"
                android:layout_height="45dp"
                android:background="#22FFFFFF"
                android:text="App 1"
                android:textColor="#DDFFFFFF"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnRecent2"
                android:layout_width="110dp"
                android:layout_height="45dp"
                android:background="#22FFFFFF"
                android:text="App 2"
                android:textColor="#DDFFFFFF"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Haupt-App-Reihen (Exakt 5 Kacheln nebeneinander) -->
        <LinearLayout
            android:id="@+id/appsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/app1"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"
                android:text="YouTube"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/app2"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"
                android:text="Netflix"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/app3"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"
                android:text="Prime Video"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/app4"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"
                android:text="Spotify"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/app5"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"
                android:text="Mediathek"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
